4. Count Validation: Compare Count b/w Source & Target tables
WITH source_data AS(
  SELECT * FROM Source_tables
  ),

target_data AS(
  SELECT * FROM Target_table
  )

  SELECT 'SOURCE', COUNT(*)
    FROM source_data
  UNION ALL
   SELECT 'TARGET', COUNT(*)
    FROM target_data
