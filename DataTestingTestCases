5. Data Validation: Compare Data b/w Source & Target tables
WITH source_data AS(
  SELECT * FROM Source_tables
  ),

target_data AS(
  SELECT * FROM Target_table
  )

  SELECT 'SOURCE', *
    FROM
    (
    SELECT *
    FROM source_data
  MINUS
   SELECT *
    FROM target_data
    )
    UNION ALL
    SELECT 'TARGET', *
    FROM
    (
    SELECT *
    FROM target_data
  EXCEPT
   SELECT *
    FROM source_data
    )
