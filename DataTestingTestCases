9. Null & Blank Statistics: Will provide all columns nulls & blanks percentage & count
Code:
%python
from pyspark.sql import functions as F

# User input for filtering
market_code = "GLOBAL"  # <-- replace with user input

# Load your table with filter
df = spark.table("uc_qa_snt_supplychain_01.nd_gold.ForexCurrencyConversion") \
          .filter(F.col("XTNMARKETCODE") == market_code)

total_records = df.count()

if total_records == 0:
    print(f"No records found for XTNMARKETCODE = {market_code}")
else:
    # Build expressions for null/blank counts in one pass
    exprs = []
    for col, dtype in df.dtypes:
        exprs.append(F.sum(F.when(F.col(col).isNull(), 1).otherwise(0)).alias(f"{col}_null_count"))
        if dtype == "string":
            exprs.append(F.sum(F.when(F.trim(F.col(col)) == "", 1).otherwise(0)).alias(f"{col}_blank_count"))

    # Run aggregation once
    agg_df = df.agg(*exprs).collect()[0]

    # Prepare results
    results = []
    for col, dtype in df.dtypes:
        null_count = agg_df[f"{col}_null_count"]
        blank_count = agg_df[f"{col}_blank_count"] if dtype == "string" else 0
        null_percentage = (null_count / total_records) * 100
        blank_percentage = (blank_count / total_records) * 100
        results.append((
            col,
            total_records,
            null_count,
            blank_count,
            "{:.2f}".format(null_percentage),   # <-- 2-decimal format
            "{:.2f}".format(blank_percentage)   # <-- 2-decimal format
        ))

    # Convert to DataFrame for display
    stat_cols = ["KPI", "total_records", "null_count", "blank_count", "null_percentage", "blank_percentage"]
    stat_df = spark.createDataFrame(results, stat_cols)

    # Display in copy-able table format
    stat_df.show(truncate=False, n=200)   # n=200 → show more rows fully

